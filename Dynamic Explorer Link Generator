function generateTransactionExplorerLink(networkKey, txHash) {
  const network = SUPPORTED_NETWORKS[networkKey];
  if (!network) throw new Error("Unsupported network");

  const fullUrl = `${network.explorerTxUrl}${txHash}`;
  
  return {
    network: network.name,
    txHash: txHash,
    verificationUrl: fullUrl,
    htmlLink: `<a href="${fullUrl}" target="_blank">View on ${network.name} Explorer</a>`
  };
}

